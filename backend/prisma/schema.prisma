}

model Pronostico {
  id              String   @id @default(uuid())
  productoId      String   @map("producto_id")
  producto        Producto @relation(fields: [productoId], references: [id])
  bodegaId        String   @map("bodega_id")
  fecha           DateTime
  demandaEstimada Decimal  @db.Decimal(18, 6) @map("demanda_estimada")
  metodo          String // PROMEDIO_MOVIL | REGLA_SIMPLE
  errorAbsolutoMedio Decimal? @db.Decimal(18, 6) @map("error_absoluto_medio")
  creadoEn        DateTime @default(now())

  @@map("pronosticos")
}

model Escenario {
  id           String   @id @default(uuid())
  nombre       String
  supuestos    Json // { incrementoDemandaPct, retrasoProveedorDias, ... }
  resultado    Json?
  creadoPorId  String   @map("creado_por_id")
  creadoEn     DateTime @default(now())

  @@map("escenarios")
}

// ----------------------------------------------------------------------------
// 16. CENTRO DE CARGAS DE DATOS
// ----------------------------------------------------------------------------

model PlantillaCarga {
  id          String   @id @default(uuid())
  empresaId   String?  @map("empresa_id")
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  entidad     String // PRODUCTOS | PROVEEDORES | BODEGAS | UBICACIONES | CONVERSIONES | PARAMETROS_REPOSICION | LOTES | SERIES | INVENTARIO_INICIAL
  version     String
  descripcionCampos Json // [{campo, obligatorio, formato, longitud, valoresAdmitidos, ejemplo}]
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  mapeos   MapeoCarga[]
  cargas   CargaDatos[]

  @@unique([entidad, version])
  @@map("plantillas_carga")
}

model MapeoCarga {
  id            String         @id @default(uuid())
  empresaId     String         @map("empresa_id")
  plantillaId   String         @map("plantilla_id")
  plantilla     PlantillaCarga @relation(fields: [plantillaId], references: [id])
  nombre        String
  correspondencia Json // { "columnaArchivo": "campoSistema" }
  creadoEn      DateTime       @default(now())

  @@map("mapeos_carga")
}

enum ModoCarga {
  SOLO_CREACION
  SOLO_ACTUALIZACION
  CREACION_Y_ACTUALIZACION
  VALIDACION_SIN_APLICAR
}

enum EstadoCarga {
  RECIBIDA
  VALIDANDO
  VALIDADA_CON_ERRORES
  SIMULADA
  PENDIENTE_APROBACION
  APROBADA
  EJECUTANDO
  EJECUTADA
  RECHAZADA
  ANULADA
}

// Clave de idempotencia: evita que reintentar la misma solicitud duplique
// efectos. Se calcula por empresa+entidad+hash de contenido (ver carga.service).
model CargaDatos {
  id               String         @id @default(uuid())
  empresaId        String         @map("empresa_id")
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  plantillaId      String         @map("plantilla_id")
  plantilla        PlantillaCarga @relation(fields: [plantillaId], references: [id])
  claveIdempotencia String        @unique @map("clave_idempotencia")
  nombreArchivo    String         @map("nombre_archivo")
  modo             ModoCarga
  estado           EstadoCarga    @default(RECIBIDA)
  totalFilas       Int            @default(0) @map("total_filas")
  filasCrear       Int            @default(0) @map("filas_crear")
  filasActualizar  Int            @default(0) @map("filas_actualizar")
  filasRechazar    Int            @default(0) @map("filas_rechazar")
  filasSinCambio   Int            @default(0) @map("filas_sin_cambio")
  creadoPorId      String         @map("creado_por_id")
  creadoPor        Usuario        @relation("cargaCreadaPor", fields: [creadoPorId], references: [id])
  aprobadoPorId    String?        @map("aprobado_por_id")
  aprobadoPor      Usuario?       @relation("cargaAprobadaPor", fields: [aprobadoPorId], references: [id])
  creadoEn         DateTime       @default(now())
  procesadoEn      DateTime?      @map("procesado_en")

  filas    CargaFila[]
  errores  CargaError[]

  @@map("cargas_datos")
}

model CargaFila {
  id            String     @id @default(uuid())
  cargaId       String     @map("carga_id")
  carga         CargaDatos @relation(fields: [cargaId], references: [id])
  numeroFila    Int        @map("numero_fila")
  datosOriginales Json     @map("datos_originales")
  datosPropuestos Json?    @map("datos_propuestos")
  accion        String // CREAR | ACTUALIZAR | SIN_CAMBIO | RECHAZAR
  entidadResultanteId String? @map("entidad_resultante_id")
  procesada     Boolean    @default(false)

  @@index([cargaId, numeroFila])
  @@map("cargas_filas")
}

model CargaError {
  id         String     @id @default(uuid())
  cargaId    String     @map("carga_id")
  carga      CargaDatos @relation(fields: [cargaId], references: [id])
  numeroFila Int        @map("numero_fila")
  campo      String?
  severidad  String // BLOQUEANTE | ADVERTENCIA
  mensaje    String

  @@map("cargas_errores")
}

// ----------------------------------------------------------------------------
// 17. INTELIGENCIA DE INVENTARIO
// ----------------------------------------------------------------------------

model Alerta {
  id                 String    @id @default(uuid())
  empresaId          String    @map("empresa_id")
  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  tipo               String // BAJO_PUNTO_REPOSICION | SOBRESTOCK | VENCIMIENTO_PROXIMO | PROVEEDOR_INCUMPLIMIENTO | DATO_INCOMPLETO
  entidad            String?
  entidadId          String?   @map("entidad_id")
  severidad          String // ALTA | MEDIA | BAJA
  evidencia          Json
  estado             String    @default("ABIERTA") // ABIERTA | EN_REVISION | ATENDIDA | DESCARTADA
  creadoEn           DateTime  @default(now())

  accionesRecomendadas AccionRecomendada[]

  @@map("alertas")
}

model AccionRecomendada {
  id              String   @id @default(uuid())
  alertaId        String   @map("alerta_id")
  alerta          Alerta   @relation(fields: [alertaId], references: [id])
  descripcion     String
  impactoEstimado Json?
  responsableId   String?  @map("responsable_id")
  fechaObjetivo   DateTime? @map("fecha_objetivo")
  estado          String   @default("PROPUESTA") // PROPUESTA | ACEPTADA | RECHAZADA | POSTERGADA | CONVERTIDA_SOLICITUD
  justificacion   String?
  creadoEn        DateTime @default(now())

  @@map("acciones_recomendadas")
}
