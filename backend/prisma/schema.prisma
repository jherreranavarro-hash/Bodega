  cantidadRecibida Decimal     @default(0) @db.Decimal(18, 6) @map("cantidad_recibida")
  cantidadRechazada Decimal    @default(0) @db.Decimal(18, 6) @map("cantidad_rechazada")
  costoUnitarioPactado Decimal @db.Decimal(18, 6) @map("costo_unitario_pactado")

  recepcionesDetalle RecepcionDetalle[]

  @@map("ordenes_compra_detalle")
}

