  moneda        String                @default("CLP")
  fechaEmision  DateTime              @default(now()) @map("fecha_emision")
  fechaCompromisoOriginal DateTime?   @map("fecha_compromiso_original")
  fechaCompromisoActual   DateTime?   @map("fecha_compromiso_actual")
  aprobadaPorId String?               @map("aprobada_por_id")
  creadoEn      DateTime              @default(now())

  detalle     OrdenCompraDetalle[]
  recepciones Recepcion[]

  @@unique([empresaId, folio])
  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
