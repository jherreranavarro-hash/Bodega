# ---- Aplicación ----
PORT=4100
HOST=127.0.0.1
# Contraseña para entrar a la aplicación (si falta se genera una temporal al iniciar)
APP_PASSWORD=
# Secreto para firmar sesiones (cualquier texto largo aleatorio)
SESSION_SECRET=
# Fuerza el modo simulación aunque haya credenciales (simulacion | vacío)
MODO=

# ---- Tenant de Microsoft 365 (registro de aplicación en Entra ID) ----
TENANT_ID=
CLIENT_ID=
# Opción A: secreto de cliente (solo Microsoft Graph)
CLIENT_SECRET=
# Opción B (recomendada): PEM con certificado + clave privada para Microsoft Graph
CERT_PEM_PATH=

# ---- Exchange Online / Purview PowerShell (solo certificado) ----
CERT_PFX_PATH=
CERT_PFX_PASSWORD=
# Dominio inicial, ej. contoso.onmicrosoft.com (se detecta solo si se omite)
ORG_DOMAIN=
# Ruta a PowerShell 7
PWSH_PATH=pwsh
