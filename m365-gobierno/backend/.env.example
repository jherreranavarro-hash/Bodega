# ---- Aplicación ----
PORT=4100
HOST=127.0.0.1
# Contraseña para entrar a la aplicación (si falta se genera una temporal al iniciar)
APP_PASSWORD=
# Secreto para firmar sesiones (cualquier texto largo aleatorio)
SESSION_SECRET=
# URL con la que el navegador abre la app. Define el redirect URI del inicio de sesión con Microsoft:
#   <PUBLIC_URL>/api/auth/callback  (regístralo en cada app de DEV/POC/PRD)
PUBLIC_URL=http://localhost:4100
# Fuerza el modo simulación aunque haya credenciales (simulacion | vacío)
MODO=

# ---- OPCIONAL: ambiente desatendido con credenciales de aplicación ----
# Lo habitual es registrar DEV/POC/PRD desde la página "Conexión" e iniciar sesión
# como administrador (contraseña + MFA en Microsoft). Esto es solo para automatización sin persona.
TENANT_ID=
CLIENT_ID=
# Opción A: secreto de cliente (solo Microsoft Graph)
CLIENT_SECRET=
# Opción B (recomendada): PEM con certificado + clave privada para Microsoft Graph
CERT_PEM_PATH=

# ---- Exchange Online / Purview PowerShell (solo certificado) ----
CERT_PFX_PATH=
CERT_PFX_PASSWORD=
# Dominio inicial, ej. contoso.onmicrosoft.com (se detecta solo si se omite)
ORG_DOMAIN=
# Ruta a PowerShell 7
PWSH_PATH=pwsh
